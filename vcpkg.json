{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "immune",
  "version": "0.1.0",
  "description": "IMMUNE - tower defense with a 10,000-agent pathogen horde simulation",
  "builtin-baseline": "f1d4bbc72f183441403ba5107cb19d75a5abc2a2",
  "dependencies": [
    "sdl2",
    {
      "name": "glad",
      "features": [
        "gl-api-45"
      ]
    },
    "glm",
    "entt",
    "nlohmann-json",
    {
      "name": "imgui",
      "features": [
        "sdl2-binding",
        "opengl3-binding",
        "docking-experimental"
      ]
    },
    "stb",
    "catch2"
  ],
  "overrides": [
    {
      "name": "imgui",
      "version": "1.91.8",
      "port-version": 2
    }
  ]
}
