# Local per-machine Claude Code settings
.claude/settings.local.json

# Scratch output (screenshots, ad-hoc dumps) from VS Code tasks
/scratch/

# Per-machine perf trend log from tools/bench_report.py -- numbers vary by
# machine, so this is a local tracking file, not a committed artifact.
/tools/bench_history.csv

# ImGui's own window-layout state, written next to the working directory
# at runtime
imgui.ini

# Balance sweep output from tools/balance_sweep.py -- hundreds of per-run JSON
# reports plus their digest. Regenerated on demand and specific to one config
# hash, so it is a local artifact, not a committed one.
/tools/balance/
